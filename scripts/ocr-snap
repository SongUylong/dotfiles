#!/usr/bin/env bash
# OCR Snap — select a screen region, OCR it, copy text to clipboard.
# Works on both macOS (screencapture + pbcopy) and Linux/Wayland (grim + slurp + wl-copy).
# Requires: tesseract, and on Linux: grim, slurp, wl-copy, notify-send
set -euo pipefail

lang="${1:-eng}"

export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

tmp_img="${XDG_RUNTIME_DIR:-/tmp}/ocr_snap_$$.png"
trap 'rm -f "$tmp_img"' EXIT

# ── Capture ──────────────────────────────────────────────────────────────────
if [[ "$(uname -s)" == "Darwin" ]]; then
  screencapture -i "$tmp_img"
else
  # Wayland: grim + slurp
  region=$(slurp 2>/dev/null) || exit 0
  grim -g "$region" "$tmp_img"
fi

[[ -f "$tmp_img" && -s "$tmp_img" ]] || exit 0

# ── OCR ──────────────────────────────────────────────────────────────────────
ocr_text=$(tesseract "$tmp_img" stdout -l "$lang" --psm 3 2>/dev/null)

if [[ -n "${ocr_text//[[:space:]]/}" ]]; then
  if [[ "$(uname -s)" == "Darwin" ]]; then
    printf '%s' "$ocr_text" | pbcopy
    osascript -e 'display notification "Text copied to clipboard!" with title "OCR Snap"'
  else
    printf '%s' "$ocr_text" | wl-copy
    notify-send "OCR Snap" "Text copied to clipboard!" -t 3000
  fi
else
  if [[ "$(uname -s)" == "Darwin" ]]; then
    osascript -e 'display notification "No text found in selection." with title "OCR Snap"'
  else
    notify-send "OCR Snap" "No text found in selection." -t 3000
  fi
fi

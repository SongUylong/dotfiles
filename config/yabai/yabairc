#!/usr/bin/env sh

export PATH="/opt/homebrew/bin:$PATH"

# Load scripting addition (required for space --focus, space --move, etc.)
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Keep windows clear of SketchyBar, then preserve the roomy AeroSpace feel.
yabai -m config external_bar all:40:0
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config top_padding 10
yabai -m config bottom_padding 10
yabai -m config left_padding 10
yabai -m config right_padding 10
yabai -m config window_gap 10

yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off
yabai -m config window_opacity off

# Match the old AeroSpace behavior for apps that should not tile.
yabai -m rule --add app="^Adobe Illustrator$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Finder$" title="Preferences" manage=off

# Pin messaging apps to space 3 (WhatsApp has a hidden RTL char prefix)
yabai -m rule --add app="^Telegram$" space=3
yabai -m rule --add app="WhatsApp"   space=3
yabai -m rule --add app="^WeChat$"   space=3

# Space layout depends on display count:
#   1 display  → 5 spaces on built-in (1-5)
#   2 displays → 3 spaces on built-in (1-3) + 2 spaces on external (4-5)
#                so that space 4 is always the external monitor workspace
display_count=$(yabai -m query --displays | jq 'length')

if [ "$display_count" -ge 2 ]; then
  target_total=5
  target_d1=3
else
  target_total=5
  target_d1=5
fi

# Ensure we have exactly target_total spaces
while [ "$(yabai -m query --spaces | jq 'length')" -lt "$target_total" ]; do
  yabai -m space --create >/dev/null 2>&1 || break
done
while [ "$(yabai -m query --spaces | jq 'length')" -gt "$target_total" ]; do
  last_idx=$(yabai -m query --spaces | jq 'length')
  yabai -m space "$last_idx" --destroy >/dev/null 2>&1 || break
done

# On dual display: move spaces 4 & 5 to display 2 (external monitor)
if [ "$display_count" -ge 2 ]; then
  yabai -m space --focus 1 2>/dev/null || true
  sleep 0.2
  # Move spaces to external only if not already there
  d1_count=$(yabai -m query --spaces | jq '[.[] | select(.display == 1)] | length')
  while [ "$d1_count" -gt "$target_d1" ]; do
    # Find highest-indexed space still on d1 and move it to d2
    last_d1=$(yabai -m query --spaces | jq '[.[] | select(.display == 1)] | last | .index')
    yabai -m space "$last_d1" --display 2 2>/dev/null || break
    sleep 0.2
    d1_count=$(yabai -m query --spaces | jq '[.[] | select(.display == 1)] | length')
  done
fi

# Remove any previously registered signals to avoid duplicates on restart.
yabai -m signal --remove sketchybar_space_changed   2>/dev/null || true
yabai -m signal --remove sketchybar_window_created  2>/dev/null || true
yabai -m signal --remove sketchybar_window_destroyed 2>/dev/null || true
yabai -m signal --remove sketchybar_app_launched    2>/dev/null || true
yabai -m signal --remove sketchybar_app_terminated  2>/dev/null || true
yabai -m signal --remove messaging_layout_telegram  2>/dev/null || true
yabai -m signal --remove messaging_layout_whatsapp  2>/dev/null || true
yabai -m signal --remove messaging_layout_wechat    2>/dev/null || true

refresh_bar="$HOME/.config/sketchybar/plugins/update_workspace_icons.sh"
yabai -m signal --add label=sketchybar_space_changed    event=space_changed        action="$refresh_bar"
yabai -m signal --add label=sketchybar_window_created   event=window_created       action="$refresh_bar"
yabai -m signal --add label=sketchybar_window_destroyed event=window_destroyed     action="$refresh_bar"
yabai -m signal --add label=sketchybar_app_launched     event=application_launched action="$refresh_bar"
yabai -m signal --add label=sketchybar_app_terminated   event=application_terminated action="$refresh_bar"

# Trigger messaging layout when Telegram/WhatsApp/WeChat opens
msg_layout="$HOME/.config/yabai/plugins/messaging_layout.sh"
yabai -m signal --add label=messaging_layout_telegram event=window_created app='^Telegram$' action="$msg_layout"
yabai -m signal --add label=messaging_layout_whatsapp event=window_created app='WhatsApp'   action="$msg_layout"
yabai -m signal --add label=messaging_layout_wechat   event=window_created app='^WeChat$'   action="$msg_layout"

# Reload sketchybar so space items are rebuilt with the current space list.
sketchybar --reload

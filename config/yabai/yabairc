#!/usr/bin/env sh

export PATH="/opt/homebrew/bin:$PATH"

# Keep windows clear of SketchyBar, then preserve the roomy AeroSpace feel.
yabai -m config external_bar all:40:0
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config top_padding 30
yabai -m config bottom_padding 30
yabai -m config left_padding 30
yabai -m config right_padding 30
yabai -m config window_gap 30

yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off
yabai -m config window_opacity off

# Match the old AeroSpace behavior for apps that should not tile.
yabai -m rule --add app="^Adobe Illustrator$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Finder$" title="Preferences" manage=off

# Keep seven numbered spaces available, like the AeroSpace config.
while [ "$(yabai -m query --spaces | jq 'length')" -lt 7 ]; do
  yabai -m space --create >/dev/null 2>&1 || break
done

refresh_bar="$HOME/.config/sketchybar/plugins/update_workspace_icons.sh"
yabai -m signal --add event=space_changed action="$refresh_bar"
yabai -m signal --add event=window_created action="$refresh_bar"
yabai -m signal --add event=window_destroyed action="$refresh_bar"
yabai -m signal --add event=application_launched action="$refresh_bar"
yabai -m signal --add event=application_terminated action="$refresh_bar"

$HOME/.config/sketchybar/plugins/update_workspace_icons.sh

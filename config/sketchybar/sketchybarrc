#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
sketchybar --bar position=top height=40 blur_radius=0 color=0x40000000

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

##### Default Item Style #####
default=(
  padding_left=6
  padding_right=6
  icon.font="CaskaydiaCove Nerd Font:Bold:14.0"
  label.font="SF Pro:Semibold:13.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=0
  label.padding_right=0
  updates=on
)
sketchybar --default "${default[@]}"

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

# Spaces with dynamic app icons
while read -r sid display_id; do
  sketchybar --add item space.$sid left \
    --set space.$sid display="$display_id" \
    --set space.$sid \
    drawing=on \
    background.color=0xff3c3e4f \
    background.corner_radius=14 \
    background.height=28 \
    background.drawing=on \
    icon.drawing=on \
    icon.color=0xffffffff \
    icon.font="CaskaydiaCove Nerd Font:Bold:16.0" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    icon.y_offset=-1 \
    label.drawing=off \
    click_script="yabai -m space --focus $sid && $PLUGIN_DIR/update_workspace_icons.sh" \
    script=""
done < <(yabai -m query --spaces | jq -r '.[] | select(.index <= 7) | "\(.index) \(.display)"')

"$PLUGIN_DIR/update_workspace_icons.sh"

# --- Kanika Item: Added to the left side, right after workspaces ---
sketchybar --add item kanika left \
  --set kanika \
  icon="" \
  label="Potato" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="" \
  click_script="" \
  update_freq=0 \
  \
  --add item bluetooth left \
  --set bluetooth icon="󰂯" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/bluetooth.sh" \
  click_script="open 'x-apple.systempreferences:com.apple.preferences.Bluetooth'" \
  update_freq=10 \
  \
  --add item network left \
  --set network \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/network.sh" \
  update_freq=2 \
  \
  --add item monitor left \
  --set monitor \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/monitor.sh" \
  update_freq=10

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

##### Right Side Items #####
sketchybar --add item clock right \
  --set clock \
  icon="󰥔" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/clock.sh" \
  update_freq=10 \
  \
  --add item battery right \
  --set battery update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  --subscribe battery system_woke power_source_change \
  \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  --subscribe volume volume_change \
  \
  --add item wifi right \
  --set wifi icon="󰤨" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/wifi.sh" \
  click_script="open 'x-apple.systempreferences:com.apple.preference.network?Wi-Fi'" \
  update_freq=10 \
  \
  --add item cpu right \
  --set cpu \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/cpu.sh" \
  update_freq=5 \
  \
  --add item ram right \
  --set ram \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/ram.sh" \
  update_freq=5

sketchybar --update

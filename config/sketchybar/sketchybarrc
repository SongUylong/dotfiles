#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
sketchybar --bar position=top height=40 blur_radius=0 color=0x40000000

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

##### Default Item Style #####
default=(
  padding_left=6
  padding_right=6
  icon.font="CaskaydiaCove Nerd Font:Bold:14.0"
  label.font="SF Pro:Semibold:13.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=0
  label.padding_right=0
  updates=on
)
sketchybar --default "${default[@]}"

# Wipe all items so we always rebuild in the correct order.
sketchybar --remove '/.*/'

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

# Spaces — show exactly 5
SPACE_COUNT=5

# Retry yabai query up to 5 times (yabai can be briefly unavailable during reload)
spaces_raw=""
for _attempt in 1 2 3 4 5; do
  spaces_raw=$(yabai -m query --spaces 2>/dev/null | jq -r --argjson n "$SPACE_COUNT" \
    '.[] | select(.index <= $n) | "\(.index) \(.display)"')
  [ -n "$spaces_raw" ] && break
  sleep 0.3
done

if [ -n "$spaces_raw" ]; then
  while IFS=" " read -r sid display_id; do
    [ -z "$sid" ] && continue
    sketchybar --add item "space.$sid" left \
      --set "space.$sid" \
        display="$display_id" \
        drawing=on \
        background.color=0xff3c3e4f \
        background.corner_radius=14 \
        background.height=28 \
        background.drawing=on \
        icon.drawing=on \
        icon.color=0xffffffff \
        icon.font="CaskaydiaCove Nerd Font:Bold:16.0" \
        icon.padding_left=8 \
        icon.padding_right=8 \
        icon.y_offset=-1 \
        label.drawing=off \
        click_script="yabai -m space --focus $sid && $PLUGIN_DIR/update_workspace_icons.sh" \
        script=""
  done <<< "$spaces_raw"
fi

# Extract real app icons in background (skips already-extracted ones)
"$PLUGIN_DIR/extract_app_icons.sh" &

"$PLUGIN_DIR/update_workspace_icons.sh"

# --- Left side status items ---
sketchybar --add item kanika left 2>/dev/null
sketchybar --set kanika \
  icon="" \
  label="Potato" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="" \
  click_script="" \
  update_freq=0

sketchybar --add item bluetooth left 2>/dev/null
sketchybar --set bluetooth \
  icon="󰂯" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/bluetooth.sh" \
  click_script="open 'x-apple.systempreferences:com.apple.preferences.Bluetooth'" \
  update_freq=10

sketchybar --add item network left 2>/dev/null
sketchybar --set network \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/network.sh" \
  update_freq=2

sketchybar --add item monitor left 2>/dev/null
sketchybar --set monitor \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/monitor.sh" \
  update_freq=10

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

##### Right Side Items #####
sketchybar --add item clock right 2>/dev/null
sketchybar --set clock \
  icon="󰥔" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/clock.sh" \
  update_freq=10

sketchybar --add item battery right 2>/dev/null
sketchybar --set battery \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on
sketchybar --subscribe battery system_woke power_source_change

sketchybar --add item volume right 2>/dev/null
sketchybar --set volume \
  script="$PLUGIN_DIR/volume.sh" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on
sketchybar --subscribe volume volume_change

sketchybar --add item wifi right 2>/dev/null
sketchybar --set wifi \
  icon="󰤨" \
  label.drawing=on \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/wifi.sh" \
  click_script="open 'x-apple.systempreferences:com.apple.preference.network?Wi-Fi'" \
  update_freq=10

sketchybar --add item cpu right 2>/dev/null
sketchybar --set cpu \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/cpu.sh" \
  update_freq=5

sketchybar --add item ram right 2>/dev/null
sketchybar --set ram \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_right=8 \
  background.color=0xff3c3e4f \
  background.corner_radius=8 \
  background.height=28 \
  background.drawing=on \
  script="$PLUGIN_DIR/ram.sh" \
  update_freq=5

#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

# Enforce correct visual order: spaces first, then status items.
# This is idempotent — safe to run on every reload.
sketchybar --reorder space.1 space.2 space.3 space.4 space.5 \
                    kanika bluetooth network monitor

sketchybar --update

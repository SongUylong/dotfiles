#!/bin/bash
# Runs as root (LaunchDaemon com.eric.lowpower-helper) whenever NotchDock writes
# ~/.cache/notchdock/lowpower.want. The file may only contain "0" or "1"; anything
# else is ignored, so the only thing this can ever do is switch Low Power Mode.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
WANT_FILE=/Users/eric/.cache/notchdock/lowpower.want
[ -f "$WANT_FILE" ] || exit 0
want=$(head -c 1 "$WANT_FILE" 2>/dev/null)
case "$want" in 0|1) ;; *) exit 0 ;; esac
have=$(pmset -g | awk '/lowpowermode/ {print $2; exit}')
[ "$want" != "$have" ] && pmset -a lowpowermode "$want"
exit 0

{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/minimax-m2.5-free",
  "permission": {
    "bash": "ask", // Asks for confirmation before running terminal commands
    "edit": "allow" // Allows OpenCode to edit files automatically
  },
  "mcp": {
    "vercel": {
      "type": "local",
      "command": ["npx", "mcp-remote", "https://mcp.vercel.com"]
    },
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.notion.com/mcp"],
      "enabled": true
    }, // 4. PUPPETEER: Lets OpenCode spin up a headless browser to test your web app UI
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "default_agent": "build",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk_9router"
      },
      "models": {
        "provider/model-id": {
          "name": "provider/model-id"
        }
      }
    }
  },
  "model": "9router/provider/model-id",
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/provider/model-id"
    }
  }
}

# App launchers
alt - c : open -n /Applications/Cursor.app
alt - t : open -n /Applications/WezTerm.app
alt - b : open -n /Applications/Brave.app
alt - n : open -n /Applications/Notion.app
alt + shift - f : open -a Finder

# Window lifecycle and services
alt - q : yabai -m window --close
alt + shift - t : sketchybar --reload
alt + shift - 0x29 : yabai --restart-service && skhd --restart-service
alt + shift - 0x33 : focused="$(yabai -m query --windows --window | jq -r '.id')" && yabai -m query --windows --space | jq -r --arg focused "$focused" '.[] | select((.id|tostring) != $focused) | .id' | while read -r id; do yabai -m window "$id" --close; done

# Layout
alt - 0x2B : yabai -m space --layout stack || yabai -m space --layout bsp
alt - f : yabai -m window --toggle zoom-fullscreen
alt - e : /Users/eric/.config/yabai/toggle_float.sh
alt - y : yabai -m window --focus east || true; yabai -m window --warp south || true; yabai -m space --layout bsp

# Focus
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Move / swap windows
alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

# Resize, roughly matching AeroSpace smart resize.
alt + shift - 0x1B : yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0 || yabai -m window --resize top:0:-50 || yabai -m window --resize bottom:0:-50
alt + shift - 0x18 : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0 || yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50

# Spaces
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5

alt - 0x30 : yabai -m space --focus recent
alt + shift - 0x30 : yabai -m space --display next; yabai -m display --focus next

# Utilities
alt + shift - s : screencapture -c -i
alt + shift - o : /Users/eric/dotfiles/scripts/ocr-snap
alt + shift - 0x21 : /Users/eric/dotfiles/scripts/color-picker
alt + shift - i : /Users/eric/dotfiles/scripts/ocr-snap chi_sim
alt + shift - r : pkill -f "ffmpeg.*avfoundation" || ffmpeg -f avfoundation -r 30 -i "1:0" "$HOME/Desktop/screenrecord-$(date +%Y%m%d-%H%M%S).mkv" >/dev/null 2>&1 &
